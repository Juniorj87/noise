{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.{js,mjs}": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/app.html", "has": [{ "type": "host", "value": "app.noisehub.xyz" }] },
    { "source": "/app/:rest*", "destination": "/app.html", "has": [{ "type": "host", "value": "app.noisehub.xyz" }] },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/leaderboard", "destination": "/app.html" },
    { "source": "/app/skills", "destination": "/app.html" },
    { "source": "/app/referral", "destination": "/app.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/swap/build", "destination": "/api/swap" },
    { "source": "/api/automation-status", "destination": "/api/automation/status" },
    { "source": "/api/automation-runs", "destination": "/api/automation/runs" },
    { "source": "/api/scheduler-tick", "destination": "/api/cron/automation" },
    { "source": "/api/cron-tick", "destination": "/api/cron/automation" },
    { "source": "/api/:rest*", "destination": "/api/[...route]" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/tx-tracker", "schedule": "0 0 * * *" },
    { "path": "/api/cron/automation", "schedule": "0 1 * * *" }
  ]
}


