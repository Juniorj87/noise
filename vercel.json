{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.{js,mjs}": {
      "runtime": "@vercel/node@3",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/swap/build", "destination": "/api/swap" },
    { "source": "/api/automation-status", "destination": "/api/automation/status" },
    { "source": "/api/automation-runs", "destination": "/api/automation/runs" },
    { "source": "/api/scheduler-tick", "destination": "/api/automation/tick" },
    { "source": "/api/memory-delete", "destination": "/api/memory/delete" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/tx-tracker", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/automation", "schedule": "*/10 * * * *" }
  ]
}
