# Sui Action Hub — environment template.
# Copy to .env (local dev) or paste into Vercel → Settings → Environment Variables (production).
# NEVER commit real secrets.

# ---- NETWORK (spec §16) ----
# mainnet is the production default. For testnet runs set SUI_NETWORK=testnet
# (Cetus/Aftermath/DeepBook/coin tables all follow this single switch).
SUI_NETWORK=mainnet

# ---- SUI DATA TRANSPORT (gRPC primary, JSON-RPC legacy fallback) ----
# JSON-RPC is deprecated and disabled on Sui Foundation Mainnet (July 27, 2026).
# Use gRPC for production. Set SUI_TRANSPORT=jsonrpc only for legacy local dev.
SUI_TRANSPORT=grpc
# gRPC endpoint (recommended, production default). Leave empty for built-in mainnet/testnet URLs.
SUI_GRPC_URL=
# GraphQL endpoint (optional, for complex queries). Leave empty for built-in mainnet/testnet URLs.
SUI_GRAPHQL_URL=
# JSON-RPC endpoint (legacy, fallback only). NOT recommended for production.
SUI_RPC_URL=

# ---- DATABASE (spec §6, §22) ----
# PostgreSQL connection string. Recommended: Neon (pooled connection).
# Production REQUIRES this — SQLite is local-dev only and never used on Vercel.
DATABASE_URL=

# ---- ADMIN (spec §12) ----
# Required for /api/admin/*. Sent by admin.html as X-Admin-Key header only.
ADMIN_KEY=

# ---- AI (spec §10, §11) — keys server-side only, never in the frontend bundle ----
AI_PROVIDER=openrouter
AI_FALLBACK_PROVIDER=
AI_MODEL=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Custom OpenAI-compatible endpoint (optional):
AI_BASE_URL=
AI_API_KEY=

# ---- APP (spec §25, §32) ----
APP_URL=https://app.noisehub.xyz
# Strict CORS allowlist (comma-separated). Preview deploys: set
# ALLOW_PREVIEW_ORIGINS=true to also allow https://<project>.vercel.app.
ALLOWED_ORIGINS=https://app.noisehub.xyz,https://noisehub.xyz
ALLOW_PREVIEW_ORIGINS=

# ---- CRON (spec §8, §9, §21) ----
# Shared secret. Vercel Cron automatically sends "Authorization: Bearer $CRON_SECRET"
# when this env var is set on the deployment. Endpoints reject wrong/missing secrets.
CRON_SECRET=

# ---- BUSINESS (fees bps: 1 bps = 0.01%) ----
PLATFORM_SWAP_FEE_BPS=0
PLATFORM_EARN_FEE_BPS=0
REFERRAL_DEFAULT_RATE=30
REFERRAL_WINDOW_DAYS=30

# ---- ACTION HUB SERVICE FEE (platform fee collection) ----
# Wallet address that receives Action Hub platform fees. Leave empty to disable.
# NEVER set this to a user-supplied value or AI-generated address.
ACTION_HUB_FEE_RECIPIENT=
# Default platform fee in basis points (1 bps = 0.01%). Can be overridden per provider/action.
ACTION_HUB_DEFAULT_FEE_BPS=0

# ---- PROVIDERS (optional overrides; defaults are the official endpoints) ----
AFTERMATH_API_URL=https://aftermath.finance
