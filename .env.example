# Noise Hub environment template. Placeholders only — never commit real secrets.
# Copy to .env for local dev (.env is git-ignored).

# Network (mainnet | testnet)
SUI_NETWORK=mainnet
# gRPC endpoint override. Default: https://fullnode.<network>.sui.io
SUI_GRPC_URL=
# Transport: grpc (default) | jsonrpc | legacy. jsonrpc/legacy use SUI_RPC_URL below.
SUI_TRANSPORT=grpc
# Legacy JSON-RPC fallback (third-party providers; Foundation fullnode JSON-RPC is deprecated).
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql

# Database (PostgreSQL / Neon pooled connection string). Required in production.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Separate test database for npm run test:pg. NEVER point this at production:
# the suite writes test rows and runs the automation tick. Honored only when
# NODE_ENV=test (the pg suite sets it automatically).
TEST_DATABASE_URL=postgres://user:password@host/dbname_test?sslmode=require
# Local dev SQLite path (server/src/db.js). Default: ./data/hub.db
DB_PATH=./data/hub.db

# Local API port (server/src/server.js). Default: 3001
PORT=3001

# Security & Cron (server-side only, never exposed to the browser)
ADMIN_KEY=your_secure_admin_key_here
CRON_SECRET=your_secure_cron_secret_here

# CORS: comma-separated extra origins. Production default (when unset):
# https://noisesui.vercel.app, https://app.noisehub.xyz, https://noisehub.xyz
ALLOWED_ORIGINS=
# Set to 'true' to additionally allow https://*.vercel.app preview deployments.
ALLOW_PREVIEW_ORIGINS=

# AI assistance (server-side keys only; keys optional — live-tools router works without them)
AI_PROVIDER=openrouter
# Required with a real key: exact model ID from your provider catalogue.
AI_MODEL=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Custom OpenAI-compatible endpoint: AI_PROVIDER=custom requires AI_BASE_URL + AI_API_KEY.
AI_BASE_URL=
AI_API_KEY=
# Generic fallback key for the active provider when its specific key above is unset.
LLM_API_KEY=
# Provider tried when the primary fails. Default: none.
AI_FALLBACK_PROVIDER=

# Platform Fee Recipient & Rates (2 bps = 0.02% — launch rate, raise per-provider later via DB config)
# IMPORTANT: the on-chain fee leg is gated by ACTION_HUB_DEFAULT_FEE_BPS and the
# recipient below. Both values must remain aligned — keep
# the two bps values IDENTICAL or the displayed fee will not equal the leg that
# is actually added to the transaction (displayed fee === collected fee).
ACTION_HUB_DEFAULT_FEE_BPS=2
PLATFORM_SWAP_FEE_BPS=2
PLATFORM_EARN_FEE_BPS=0
ACTION_HUB_FEE_RECIPIENT=0xa29a8f72981c5644c348a51cd4aded6dbb47ad4361f7a825e19d377e9c4373a1

# Referral attribution (sidebar Referrals; leaderboard reads accounting only).
# No automatic payouts are enabled.
REFERRAL_DEFAULT_RATE=30

# Noise Hub revenue wallet (PUBLIC Sui address — settlement/verification only).
# Safe to display and commit the address itself. NEVER commit a private key,
# seed or mnemonic for this (or any) wallet — signing stays non-custodial.
NOISE_HUB_REVENUE_WALLET=0xa29a8f72981c5644c348a51cd4aded6dbb47ad4361f7a825e19d377e9c4373a1

# Referral / revenue controls
REFERRAL_WINDOW_DAYS=30
MIN_PAYOUT=1
# Stage 1: claims are intents only (no auto-send). Keep false until the
# dedicated server signer (stage 2) exists.
PAYOUT_ENABLED=false
LEADERBOARD_ENABLED=true
LEADERBOARD_CACHE_MS=45000

# Optional advanced STEAMM/oracle integration; never commit a real token.
PYTH_PRO_ACCESS_TOKEN=
